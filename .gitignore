# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitear credenciales reales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Permitir solo el archivo de ejemplo (sin credenciales reales)
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma — no commitear migraciones generadas automáticamente en dev
# (solo si usas db push en vez de migrate)
# prisma/migrations/

# Logos / uploads de empresa (archivos binarios grandes)
public/uploads/

# Logs
*.log
